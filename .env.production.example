# Production variables for infra/.env
# After first `make up` or `./scripts/deploy-server.sh`, merge these into infra/.env
# (or copy this file to infra/.env and re-run setup only if genesis is missing).

# --- Public URL (for CORS; UI is served from the same host via nginx proxy) ---
# Example: https://auction.university.example
CORS_ORIGINS=https://your-domain.example

# --- JWT (required in production; deploy-server.sh can generate automatically) ---
JWT_SECRET_KEY=

# --- PostgreSQL (change defaults before going live) ---
DB_USER=unidapp
DB_PASSWORD=change-me-strong-password
DB_NAME=unidapp
DB_HOST=db
DB_PORT=5432

# --- Application flags ---
DEBUG=false
ALLOW_DEMO_TOPUP=false

# --- Published ports (frontend only; bind to localhost if using reverse proxy) ---
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=80

# --- Optional: skip image pull on slow networks ---
# SKIP_IMAGE_PULL=1
